meta {
  name: Authenticated Errors Carry Attribution
  type: http
  seq: 2
}

get {
  url: {{baseUrlExpenseCore}}/expense-core/v1/groups/00000000-0000-0000-0000-000000000099
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("missing resource is a structured problem", function() {
    expect(res.getStatus()).to.eql(404);
    const problem = res.getBody();
    expect(res.getHeader("Content-Type")).to.match(/^application\/problem\+json/);
    expect(problem.code).to.be.a("string");
    expect(problem.numericCode).to.match(/^[1-9][0-9]{5}$/);
    expect(problem.errorName).to.match(/^[A-Z0-9_]{3,64}$/);
    expect(problem.requestId).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);
    const body = res.getBody();
    expect(body.code).to.be.ok;
    expect(body.source).to.eql("expense-core");
    expect(body.requestId).to.be.ok;
  });
}
