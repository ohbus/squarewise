meta {
  name: Unauthenticated Expense Operations Must Be Rejected
  type: http
  seq: 2
}

get {
  url: {{baseUrlExpenseCore}}/expense-core/v1/groups/00000000-0000-0000-0000-000000000001/expenses
  body: none
  auth: none
}

tests {
  test("missing authentication is rejected before resource lookup", function() {
    expect(res.getStatus()).to.eql(401);
    const problem = res.getBody();
    expect(res.getHeader("Content-Type")).to.match(/^application\/problem\+json/);
    expect(problem.code).to.be.a("string");
    expect(problem.numericCode).to.match(/^[1-9][0-9]{5}$/);
    expect(problem.errorName).to.match(/^[A-Z0-9_]{3,64}$/);
    expect(problem.requestId).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);
  });

  test("challenge identifies bearer authentication", function() {
    expect(res.getHeader("WWW-Authenticate")).to.match(/^Bearer/);
  });
}
