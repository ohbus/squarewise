meta {
  name: Invalid bearer is rejected by BFF
  type: http
  seq: 6
}

post {
  url: {{baseUrlBff}}/graphql
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer not-a-signed-jwt
}

body:json {
  {
    "query": "{ groups { id name } }"
  }
}

tests {
  test("malformed bearer is rejected", function() {
    expect(res.getStatus()).to.eql(401);
    const problem = res.getBody();
    expect(res.getHeader("Content-Type")).to.match(/^application\/problem\+json/);
    expect(problem.code).to.be.a("string");
    expect(problem.numericCode).to.match(/^[1-9][0-9]{5}$/);
    expect(problem.errorName).to.match(/^[A-Z0-9_]{3,64}$/);
    expect(problem.requestId).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);
  });
}
