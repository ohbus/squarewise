# ==============================================================================
# Squarewise Environment Variables & CI Secrets Matrix
#
# This file serves as the comprehensive catalog of all configurable environment
# variables across Squarewise (local development, test suites, Compose, and CI).
#
# Any variable marked with [SECRET] can be set as an Actions Secret in:
#   GitHub Repository -> Settings -> Secrets and variables -> Actions -> Repository secrets
# Any variable marked with [CONFIG] can be set as an Actions Variable in:
#   GitHub Repository -> Settings -> Secrets and variables -> Actions -> Variables
#
# DO NOT COMMIT POPULATED SECRETS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CRYPTOGRAPHIC KEYS & SECURITY [CRITICAL SECRETS]
# ------------------------------------------------------------------------------

# 32-byte Base64 key used for HMAC-SHA256 derivation of login verification tokens
# and deterministic rate-limiting partition digests.
# Required in: Accounts, BFF, Notifications.
# Generate: openssl rand -base64 32
# GitHub Action Secret: SQUAREWISE_SECURITY_CREDENTIAL_DIGEST_SECRET
SQUAREWISE_SECURITY_CREDENTIAL_DIGEST_SECRET=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=

# 32-byte Base64 AES-GCM encryption key used to seal passwordless auth tokens in
# the transactional outbox before background mail delivery.
# Required in: Accounts, Notifications.
# Generate: openssl rand -base64 32
# GitHub Action Secret: SQUAREWISE_SECURITY_AUTH_EMAIL_ENVELOPE_KEY
SQUAREWISE_SECURITY_AUTH_EMAIL_ENVELOPE_KEY=ICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8=

# Allowed CORS origins for the Accounts browser session endpoints (comma-separated).
# GitHub Action Variable / Env: SQUAREWISE_SECURITY_BROWSER_ALLOWED_ORIGINS
SQUAREWISE_SECURITY_BROWSER_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 2. INFRASTRUCTURE & BACKING SERVICE CREDENTIALS [SECRETS]
# ------------------------------------------------------------------------------

# Redis server authentication password.
# Required in: Redis container, Accounts, BFF, Notifications.
# Local default: squarewise-redis-local-only
# GitHub Action Secret: REDIS_PASSWORD
REDIS_PASSWORD=squarewise-redis-local-only

# PostgreSQL database administrator and application connection password.
# Required in: Postgres container, Accounts, Expense Core, Notifications.
# Local default: squarewise-local-only
# GitHub Action Secret: POSTGRES_PASSWORD
POSTGRES_PASSWORD=squarewise-local-only

# PostgreSQL replication password for read-replica streaming.
# Local default: squarewise-replica-local-only
# GitHub Action Secret: POSTGRES_REPLICATION_PASSWORD
POSTGRES_REPLICATION_PASSWORD=squarewise-replica-local-only

# RabbitMQ broker default user password.
# Required in: RabbitMQ container, Accounts, Expense Core, Notifications, BFF.
# Local default: squarewise-local-only
# GitHub Action Secret: RABBITMQ_DEFAULT_PASS
RABBITMQ_DEFAULT_PASS=squarewise-local-only

# RabbitMQ cluster Erlang cookie.
# Local default: squarewise-local-erlang-cookie
# GitHub Action Secret: RABBITMQ_ERLANG_COOKIE
RABBITMQ_ERLANG_COOKIE=squarewise-local-erlang-cookie

# Keycloak bootstrap administrator credentials.
# GitHub Action Secret: KEYCLOAK_ADMIN_PASSWORD
KEYCLOAK_ADMIN_USERNAME=local-admin
KEYCLOAK_ADMIN_PASSWORD=local-admin-only

# ------------------------------------------------------------------------------
# 3. OIDC IDENTITY PROVIDER & E2E TEST PERSONAS [CONFIG & FIXTURES]
# ------------------------------------------------------------------------------

# OIDC realm name and audience.
SQUAREWISE_SECURITY_OIDC_AUDIENCE=squarewise-api
KEYCLOAK_REALM=squarewise

# Pre-seeded Keycloak client credentials (from infra/local/keycloak/realm/)
# Used by tests/e2e/acquire_local_tokens.sh to mint tokens during CI:
#   Primary client:          squarewise-ci / squarewise-ci-local-only
#   Second persona (Bob):    squarewise-ci-e2e-bob / squarewise-ci-e2e-bob-local-only
#   Non-member persona:      squarewise-ci-e2e-nonmember / squarewise-ci-e2e-nonmember-local-only
#   Negative audience:       squarewise-ci-wrong-audience / squarewise-ci-wrong-audience-local-only
#   Wrong issuer realm:      squarewise-ci-wrong-issuer / squarewise-ci-wrong-issuer-local-only

# ------------------------------------------------------------------------------
# 4. RATE LIMITING & SECURITY POLICY TUNING [CONFIG]
# ------------------------------------------------------------------------------

# Cooldown window (seconds) between passwordless login resend requests.
# CI uses 0 for rapid probe cycles; production default is 60.
# GitHub Action Variable / Env: SQUAREWISE_AUTH_LOGIN_RESEND_COOLDOWN_SECONDS
SQUAREWISE_AUTH_LOGIN_RESEND_COOLDOWN_SECONDS=60

# Maximum login verification attempts before lockout.
# GitHub Action Variable / Env: SQUAREWISE_AUTH_LOGIN_VERIFY_MAX_REQUESTS
SQUAREWISE_AUTH_LOGIN_VERIFY_MAX_REQUESTS=5

# Verification window in seconds (default 300 = 5 minutes).
# GitHub Action Variable / Env: SQUAREWISE_AUTH_LOGIN_VERIFY_WINDOW_SECONDS
SQUAREWISE_AUTH_LOGIN_VERIFY_WINDOW_SECONDS=300

# Auth-email delivery rate limiter permits per window.
# CI test probe overrides this to 1.
# GitHub Action Variable / Env: SQUAREWISE_NOTIFICATIONS_DELIVERY_MAX_PERMITS
SQUAREWISE_NOTIFICATIONS_DELIVERY_MAX_PERMITS=10

# Auth-email delivery rate limiter window in seconds.
# CI test probe overrides this to 5.
# GitHub Action Variable / Env: SQUAREWISE_NOTIFICATIONS_DELIVERY_WINDOW_SECONDS
SQUAREWISE_NOTIFICATIONS_DELIVERY_WINDOW_SECONDS=60

# BFF GraphQL HTTP request rate limit (requests per window).
# GitHub Action Variable / Env: SQUAREWISE_BFF_GRAPHQL_MAX_HTTP_REQUESTS
SQUAREWISE_BFF_GRAPHQL_MAX_HTTP_REQUESTS=120

# BFF GraphQL HTTP rate limit window in seconds.
# GitHub Action Variable / Env: SQUAREWISE_BFF_GRAPHQL_HTTP_WINDOW_SECONDS
SQUAREWISE_BFF_GRAPHQL_HTTP_WINDOW_SECONDS=60

# BFF GraphQL WebSocket connection rate limit (connections per window).
# GitHub Action Variable / Env: SQUAREWISE_BFF_GRAPHQL_MAX_WEBSOCKET_CONNECTIONS
SQUAREWISE_BFF_GRAPHQL_MAX_WEBSOCKET_CONNECTIONS=20

# BFF GraphQL WebSocket rate limit window in seconds.
# GitHub Action Variable / Env: SQUAREWISE_BFF_GRAPHQL_WEBSOCKET_WINDOW_SECONDS
SQUAREWISE_BFF_GRAPHQL_WEBSOCKET_WINDOW_SECONDS=60

# ------------------------------------------------------------------------------
# 5. THIRD-PARTY & INTEGRATION SECRETS [OPTIONAL CI / HOSTED TOOLS]
# ------------------------------------------------------------------------------

# SonarCloud / SonarQube analysis token.
# GitHub Action Secret: SONAR_TOKEN
# SONAR_TOKEN=

# GitHub API personal access token (if custom token is needed beyond GITHUB_TOKEN).
# GitHub Action Secret: GH_TOKEN / GITHUB_TOKEN
