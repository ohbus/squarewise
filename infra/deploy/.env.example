# Replace these with immutable registry digests before a production rollout.
SQUAREWISE_ACCOUNTS_IMAGE=registry.example/squarewise-accounts:0.1.0
SQUAREWISE_EXPENSE_CORE_IMAGE=registry.example/squarewise-expense-core:0.1.0
SQUAREWISE_NOTIFICATIONS_IMAGE=registry.example/squarewise-notifications:0.1.0
SQUAREWISE_BFF_IMAGE=registry.example/squarewise-bff:0.1.0
POSTGRES_USER=squarewise
POSTGRES_PASSWORD=replace-with-secret
POSTGRES_DB=squarewise
RABBITMQ_USER=squarewise
RABBITMQ_PASSWORD=replace-with-secret
SQUAREWISE_REDIS_HOST=managed-redis.example.internal
SQUAREWISE_REDIS_PORT=6379
SQUAREWISE_REDIS_PASSWORD=replace-with-secret
SQUAREWISE_REDIS_SSL_ENABLED=true
# Base64 secret, at least 32 bytes; provision through the deployment secret manager.
SQUAREWISE_SECURITY_CREDENTIAL_DIGEST_SECRET=replace-with-base64-secret
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-secret
